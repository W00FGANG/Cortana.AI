generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agent {
  id             String       @id @default(cuid())
  name           String
  role           String
  description    String
  avatar         String?
  status         String       @default("Active") // Active, Paused
  systemPrompt   String?
  capabilities   String[]
  schedule       String?
  n8nWorkflowId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks          Task[]
  runs           AgentRun[]
  activities     Activity[]
  approvals      Approval[]

  @@index([name])
}

model Task {
  id               String       @id @default(cuid())
  agentId          String
  agent            Agent        @relation(fields: [agentId], references: [id])
  title            String
  description      String?
  status           String       @default("Pending") // Pending, Running, Completed, Failed, Needs Approval
  priority         String       @default("Medium") // Low, Medium, High
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  result           String?
  requiresApproval Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  runs             AgentRun[]
  approvals        Approval[]

  @@index([status, startedAt])
  @@index([status, createdAt])
  @@index([agentId])
}

model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id])
  status      String    // Running, Completed, Failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  input       String?
  output      String?
  error       String?

  @@index([status, startedAt])
  @@index([agentId])
}

model Activity {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  action      String
  description String?
  status      String   // Success, Failed, Running
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([agentId])
}

model Approval {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id])
  title       String
  content     String
  status      String    @default("Pending") // Pending, Approved, Rejected
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?

  @@index([status])
  @@index([agentId])
}

